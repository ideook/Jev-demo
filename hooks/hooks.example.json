{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"<PYTHON>\" -X utf8 \"<CODEX_HOME>/hooks/jev-skill-pick.py\"",
            "commandWindows": "powershell.exe -NoLogo -NoProfile -NonInteractive -EncodedCommand <UTF16LE_BASE64_FROM_INSTALLER>",
            "timeout": 25,
            "statusMessage": "Jev: selecting a relevant Codex skill",
            "additionalContextLimit": 600
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "\"<PYTHON>\" \"<REPO>/hooks/jev-hook-demo/jev_judge_hook.py\"",
            "commandWindows": "\"<PYTHON>\" \"<REPO>/hooks/jev-hook-demo/jev_judge_hook.py\"",
            "timeout": 30,
            "statusMessage": "Jev demo: checking rule test coverage",
            "additionalContextLimit": 1500
          }
        ]
      }
    ]
  }
}
